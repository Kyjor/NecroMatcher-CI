[
  {
    "id": "ping",
    "execute-command": "/usr/bin/true",
    "response-message": "webhook ok",
    "http-methods": ["GET", "HEAD"]
  },
  {
    "id": "build-necromatcher-mac",
    "execute-command": "/Users/kyjor/Documents/Projects/Julia/NecroMatcher-CI/mac-local/verify-and-run.sh",
    "response-message": "Starting NecroMatcher macOS build and Steam upload...",
    "trigger-rule": {
      "and": [
        {
          "match": {
            "type": "payload-hmac-sha256",
            "secret": "{{ getenv "GITHUB_WEBHOOK_SECRET" | js }}",
            "parameter": {
              "source": "header",
              "name": "X-Hub-Signature-256"
            }
          }
        },
        {
          "or": [
            {
              "and": [
                {
                  "match": {
                    "type": "value",
                    "value": "refs/heads/main",
                    "parameter": {
                      "source": "payload",
                      "name": "ref"
                    }
                  }
                }
              ]
            },
            {
              "and": [
                {
                  "match": {
                    "type": "value",
                    "value": "trigger-ci",
                    "parameter": {
                      "source": "payload",
                      "name": "workflow_run.display_title"
                    }
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  }
]

